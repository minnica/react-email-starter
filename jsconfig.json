{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@email/*": ["emails/_shared/*"],
      "@universities/*": ["emails/_universities/*"]
    }
  },
  "include": ["emails/**/*.js", "emails/**/*.jsx"],
  "exclude": ["node_modules", ".react-email", "out"]
}
