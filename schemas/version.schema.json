{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "version.schema.json",
  "title": "Email delivery version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryId",
    "emailId",
    "version",
    "basedOn",
    "university",
    "campaignId",
    "kitRevision",
    "layoutRevision",
    "brandRevision",
    "subject",
    "preheader",
    "status",
    "createdAt",
    "generatedAt",
    "releasedAt",
    "source",
    "output",
    "outputSha256",
    "inputSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deliveryId": { "type": "string", "minLength": 1 },
    "emailId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]{3,}$" },
    "basedOn": { "type": ["string", "null"], "pattern": "^v[0-9]{3,}$" },
    "university": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "kitRevision": { "type": "string", "minLength": 1 },
    "layoutRevision": { "type": "string", "minLength": 1 },
    "brandRevision": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "preheader": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "delivered"] },
    "createdAt": { "type": "string", "format": "date" },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "releasedAt": { "type": ["string", "null"], "format": "date-time" },
    "source": { "const": "email.tsx" },
    "output": { "const": "artifacts/email.html" },
    "outputSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "inputSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
