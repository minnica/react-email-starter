{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "email.schema.json",
  "title": "Campaign email",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "emailId", "campaignId", "university", "name", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "emailId": { "type": "string", "pattern": "^[a-z0-9]+-eml-[0-9]{4}-[0-9]{3}-[0-9]{2}$" },
    "campaignId": { "type": "string", "pattern": "^[a-z0-9]+-cmp-[0-9]{4}-[0-9]{3}$" },
    "university": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date" }
  }
}
